@startuml 03-block-host-sequence
!include _style.iuml
title Admin blocks a host: one transaction for the user, listings and reviews
autonumber

actor Admin
participant "AdminUserController" as C
box "auth" #E8F0FE
  participant "AdminUserServiceImpl\n@Transactional" as S
  database "users" as UDB
end box
participant "BookingGuard\n(common, booking implements)" as BG
participant "Spring event bus" as BUS
box "listing" #E6F4EA
  participant "UserLifecycleListener\n@EventListener" as L
  participant "ListingModerationService" as M
  database "listings" as LDB
end box
box "review" #FDECEC
  participant "ReviewAccountListener\n@EventListener" as RL
end box
box "notification" #FCE8E6
  participant "NotificationEventListener\nafter commit, @Async" as NL
end box

Admin -> C : POST /api/v2/admin/users/{id}/block\n{ reason }  + X-XSRF-TOKEN
C -> S : blockUser(adminId, userId, reason)
activate S
S -> S : not self, not an admin,\nnot already blocked (409)
S -> BG : hostHasActiveBookings(userId)?
BG --> S : no (yes = 409, cancel bookings first)
S -> UDB : isActive = false, blockReason, blockedAt
S -> S : clear authUsers / user caches after commit
S -> BUS : publishEvent(UserBlockedEvent(userId, reason))
activate BUS
BUS -> L : same thread, same transaction
activate L
L -> M : suspendAllByManager(userId)
M -> LDB : each listing -> SUSPENDED,\nkeep statusBeforeSuspension,\nsource = OWNER_BLOCKED
deactivate L
BUS -> RL : same thread, same transaction
activate RL
RL -> RL : hide the user's reviews,\nrecalculate those listings' ratings
deactivate RL
BUS --> S
deactivate BUS
S --> C
deactivate S

== COMMIT: user, listings and reviews change together or not at all ==

BUS -> NL : after commit, background thread
NL -> NL : bell row ACCOUNT_BLOCKED\n+ email with the reason
C --> Admin : 200 "User blocked"

note over M
  After commit: listingById and
  publishedListings caches are cleared.
end note
@enduml

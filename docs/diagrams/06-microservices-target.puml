@startuml 06-microservices-target
!include _style.iuml
title If BlinkStay were split later (not built, and not needed today)
left to right direction

actor Browser
node "API gateway\nchecks the JWT cookie,\nroutes by path" as GW

package "Identity service" {
  [auth: users, roles,\nhost requests, login] as AU
  database "identity DB" as ADB
}
package "Catalog service" {
  [listing + room\n(one unit: they call each other)] as LI
  database "catalog DB" as LDB
}
package "Booking service" {
  [bookings, availability,\ncancellation, calendar] as BO
  database "booking DB" as BDB
}
package "Payment service" {
  [orders, webhook,\nrefund worker, reconcile] as PA
  database "payment DB" as PDB
}
package "Notification service" {
  [email + bell] as NO
  database "notification DB" as NDB
}
package "Reviews + earnings" {
  [reviews, ratings,\nearnings ledger] as RE
  database "review DB" as RDB
}
queue "Message broker\n(Kafka or RabbitMQ)" as MQ

Browser --> GW
GW --> AU : /api/v1, /api/v2
GW --> LI : /api/v3
GW --> BO : /api/v5/bookings, /host, /availability
GW --> PA : /api/v5/payments
GW --> NO : /api/v2/notifications
GW --> RE : /api/v5/reviews, dashboards

AU --> ADB
LI --> LDB
BO --> BDB
PA --> PDB
NO --> NDB
RE --> RDB

AU --> MQ : user events\n(via outbox table)
LI --> MQ : listing events
BO --> MQ : BookingConfirmed,\nBookingCancelled
PA --> MQ : PaymentRefunded
MQ --> LI : UserBlocked / Deleted
MQ --> NO : all events
MQ --> RE : booking + user events

BO ..> PA : HTTP: refundInFull\n(today: PaymentRefunds interface)
PA ..> BO : HTTP: confirmPayment\n(today: BookingPayments interface)

note bottom of MQ
  What changes from today:
  - in-process Spring events -> broker messages
  - each publisher writes an outbox row in its own
    transaction, a relay sends it (no lost events)
  - every listener must be idempotent (duplicates)
  - Caffeine caches and in-memory OTPs -> Redis
  - one transaction for "block + suspend" becomes
    two steps with a short delay between them
end note
@enduml

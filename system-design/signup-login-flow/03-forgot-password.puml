@startuml 03-forgot-password
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Visitor\n(not logged in)" as V
actor "Timer\n(system clock)" as T

rectangle "Forgot password" {
  usecase "Request reset code\n(username + email)" as F1
  usecase "Look up active account\n(same reply either way)" as F2
  usecase "Check 60 s cooldown" as F3
  usecase "Generate OTP and store it\n(6 digits, kept 10 min)" as F4
  usecase "Reset password\n(email + OTP + new password)" as F5
  usecase "Check code and\nattempt count" as F6
  usecase "Save new password and\nlog out all devices" as F7
  usecase "Code wrong, expired\nor too many tries (400)" as F8 #LightYellow
  usecase "Reset code expires\nafter 10 min" as F9 #LightSalmon
}

V --> F1
V --> F5
F1 .> F2 : <<include>>
F1 .> F3 : <<include>>
F1 .> F4 : <<include>>
F5 .> F6 : <<include>>
F5 .> F7 : <<include>>
F8 .> F5 : <<extend>>
T --> F9

note right of F2
  Unknown or blocked account:
  nothing is sent, and the reply
  is still 200 with the same message.
end note

note right of F6
  5 wrong codes and the
  code is deleted.
end note

note right of F7
  Sessions issued before this
  moment get 401 PASSWORD_CHANGED.
  The new password must differ
  from the old one.
end note
@enduml